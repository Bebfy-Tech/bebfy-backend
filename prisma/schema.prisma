generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================
// 0. PAINEL ADMIN SAAS & CONTROLE MULTI-TENANT
// ====================================================

enum StatusEmpresa {
  ATIVA
  SUSPENSA
  CANCELADA
  EM_TESTE
}

enum TipoPlano {
  VAREJO_BASICO
  VAREJO_PRO
  ATACADO_FULL
  PERSONALIZADO
}

enum NomeModulo {
  // Varejo / PDV
  CAIXA_PDV
  FIADOS
  VASILHAMES_RETORNAVEIS
  ENTREGAS_DELIVERY

  // Atacado B2B
  PEDIDOS_ATACADO
  TABELA_PRECO_VOLUME
  ROTAS_CAMINHOES
  CREDITO_B2B

  // Gestão & Core
  ESTOQUE_LOTES
  COMPRAS_FORNECEDORES
  RELATORIOS_AVANCADOS
}

model Empresa {
  id                   Int                   @id @default(autoincrement())
  nomeFantasia         String
  razaoSocial          String?
  cnpj                 String?               @unique
  slug                 String                @unique // ex: empresa.bebfy.app -> "empresa"
  subdominio           String?               @unique // ex: "adega-do-ze", "distribuidora-lima"
  status               StatusEmpresa         @default(ATIVA)
  planoId              Int?
  plano                Plano?                @relation(fields: [planoId], references: [id])
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt

  // Relacionamentos Multi-tenant
  modulosAtivos        EmpresaModulo[]
  funcionarios         Funcionario[]
  config               ConfigGlobal?
  categorias           Categoria[]
  produtos             Produto[]
  lotes                LoteProduto[]
  fornecedores         Fornecedor[]
  notasFiscais         NotaFiscal[]
  clientes             Cliente[]
  caixas               Caixa[]
  vendas               Venda[]
  movimentacoesEstoque MovimentacaoEstoque[]
  contasPagar          ContaPagar[]
  contasReceber        ContaReceber[]

  @@map("empresas")
}

model Plano {
  id          Int        @id @default(autoincrement())
  nome        String
  tipo        TipoPlano  @default(VAREJO_BASICO)
  precoMensal Decimal    @db.Decimal(10, 2)
  empresas    Empresa[]
  criadoEm    DateTime   @default(now())

  @@map("planos")
}

model EmpresaModulo {
  id        Int        @id @default(autoincrement())
  empresaId Int
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modulo    NomeModulo
  ativo     Boolean    @default(true)
  criadoEm  DateTime   @default(now())

  @@unique([empresaId, modulo])
  @@map("empresa_modulos")
}

// ====================================================
// 1. USUÁRIOS, FUNCIONÁRIOS E PERMISSÕES
// ====================================================

enum Cargo {
  ADMINISTRADOR
  FUNCIONARIO
  PROPRIETARIO
  GERENTE
  OPERADOR_CAIXA
  ESTOQUISTA
  ENTREGADOR
}

model Funcionario {
  id             String      @id @default(uuid())
  empresaId      Int
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String
  cpf            String
  telefone       String?
  cargo          Cargo
  descontoMaximo Decimal     @default(0.00)
  ativo          Boolean     @default(true)
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt

  usuario        Usuario?
  vendas         Venda[]
  caixasFechados Caixa[]     @relation("OperadorCaixa")

  @@unique([empresaId, cpf])
}

model Usuario {
  id            String      @id @default(uuid())
  email         String      @unique
  senha         String
  funcionarioId String      @unique
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  permissoes    String[]
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
}

// ====================================================
// 2. PARÂMETROS GLOBAIS DA LOJA / TENANT
// ====================================================

model ConfigGlobal {
  id                     String   @id @default(uuid())
  empresaId              Int      @unique
  empresa                Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nomeEmpresa            String
  cnpj                   String?
  telefone               String?
  endereco               String?
  obrigarCpfClienteVenda Boolean  @default(false)
  bloquearFiadoAtrasado  Boolean  @default(true)
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt
}

// ====================================================
// 3. PRODUTOS, LOTES, VASILHAMES E CUSTOS
// ====================================================

model Categoria {
  id        String    @id @default(uuid())
  empresaId Int
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  produtos  Produto[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([empresaId, nome])
}

model Produto {
  id                Int                   @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome              String
  codigoBarras      String?
  ml                Int?
  unidadeMedida     String                @default("UN")
  fardoQuantidade   Int?
  precoCusto        Decimal               @default(0.00)
  precoVendaVarejo  Decimal               @default(0.00)
  precoVendaAtacado Decimal?
  qtdAtacadoMinima  Int?
  estoqueAtual      Int                   @default(0)
  estoqueMinimo     Int                   @default(0)
  retornavel        Boolean               @default(false)
  categoriaId       String?
  categoria         Categoria?            @relation(fields: [categoriaId], references: [id])
  criadoEm          DateTime              @default(now())
  atualizadoEm      DateTime              @updatedAt

  lotes             LoteProduto[]
  historicoCustos   HistoricoCusto[]
  itensVenda        ItemVenda[]
  itensNotaFiscal   ItemNotaFiscal[]
  movimentacoes     MovimentacaoEstoque[]

  @@unique([empresaId, codigoBarras])
}

model LoteProduto {
  id             Int       @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produtoId      Int
  produto        Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  numeroLote     String?
  quantidade     Int
  dataVencimento DateTime?
  criadoEm       DateTime  @default(now())
}

model HistoricoCusto {
  id            String   @id @default(uuid())
  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  custoAnterior Decimal
  custoNovo     Decimal
  dataAlteracao DateTime @default(now())
  criadoEm      DateTime @default(now())
}

// ====================================================
// 4. FORNECEDORES E IMPORTAÇÃO DE XML (NF-e)
// ====================================================

model Fornecedor {
  id           String       @id @default(uuid())
  empresaId    Int
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cnpj         String
  razaoSocial  String
  nomeFantasia String?
  telefone     String?
  email        String?
  criadoEm     DateTime     @default(now())

  notasFiscais NotaFiscal[]

  @@unique([empresaId, cnpj])
}

model NotaFiscal {
  id           String           @id @default(uuid())
  empresaId    Int
  empresa      Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chaveAcesso  String
  numeroNota   String
  fornecedorId String
  fornecedor   Fornecedor       @relation(fields: [fornecedorId], references: [id])
  valorTotal   Decimal
  dataEmissao  DateTime
  criadoEm     DateTime         @default(now())

  itens        ItemNotaFiscal[]
  contasAPagar ContaPagar[]

  @@unique([empresaId, chaveAcesso])
}

model ItemNotaFiscal {
  id            String     @id @default(uuid())
  notaFiscalId  String
  notaFiscal    NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto    @relation(fields: [produtoId], references: [id])
  quantidade    Int
  valorUnitario Decimal
  criadoEm      DateTime   @default(now())
}

// ====================================================
// 5. CLIENTES E GESTÃO INDIVIDUAL DE FIADOS
// ====================================================

model Cliente {
  id            String           @id @default(uuid())
  empresaId     Int
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  cpfCnpj       String?
  telefone      String?
  endereco      String?
  limiteCredito Decimal          @default(0.00)
  saldoDevedor  Decimal          @default(0.00)
  cascosEmPosse Int              @default(0)
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  vendas        Venda[]
  fiados        HistoricoFiado[]

  @@unique([empresaId, cpfCnpj])
}

enum TipoTransacaoFiado {
  DEBITO
  CREDITO
}

model HistoricoFiado {
  id        String             @id @default(uuid())
  clienteId String
  cliente   Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendaId   String?
  venda     Venda?             @relation(fields: [vendaId], references: [id])
  tipo      TipoTransacaoFiado
  valor     Decimal
  descricao String?
  saldoApos Decimal
  criadoEm  DateTime           @default(now())
}

// ====================================================
// 6. CAIXA, SANGRIAS, SUPRIMENTOS E AUDITORIA
// ====================================================

enum StatusCaixa {
  ABERTO
  FECHADO
}

model Caixa {
  id                String              @id @default(uuid())
  empresaId         Int
  empresa           Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operadorId        String
  operador          Funcionario         @relation("OperadorCaixa", fields: [operadorId], references: [id])
  saldoInicial      Decimal             @default(0.00)
  saldoFinalSistema Decimal?
  saldoFinalFisico  Decimal?
  quebraDeCaixa     Decimal?
  status            StatusCaixa         @default(ABERTO)
  abertoEm          DateTime            @default(now())
  fechadoEm         DateTime?
  criadoEm          DateTime            @default(now())

  movimentacoes     MovimentacaoCaixa[]
  vendas            Venda[]
}

enum TipoMovimentacaoCaixa {
  SUPRIMENTO
  SANGRIA
}

model MovimentacaoCaixa {
  id         String                @id @default(uuid())
  caixaId    String
  caixa      Caixa                 @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo       TipoMovimentacaoCaixa
  valor      Decimal
  categoria  String
  observacao String?
  criadoEm   DateTime              @default(now())
}

// ====================================================
// 7. PDV, VENDAS, ENTREGAS E PAGAMENTOS MISTOS
// ====================================================

enum StatusVenda {
  CONCLUIDA
  ORCAMENTO
  CANCELADA
}

enum TipoEntrega {
  RETIRADA_BALCAO
  DELIVERY
}

enum StatusEntrega {
  PENDENTE
  SEPARANDO
  SAIU_PARA_ENTREGA
  ENTREGUE
}

model Venda {
  id              String           @id @default(uuid())
  empresaId       Int
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigoVenda     Int              @default(autoincrement())
  caixaId         String
  caixa           Caixa            @relation(fields: [caixaId], references: [id])
  funcionarioId   String
  funcionario     Funcionario      @relation(fields: [funcionarioId], references: [id])
  clienteId       String?
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])
  subtotal        Decimal
  desconto        Decimal          @default(0.00)
  valorTotal      Decimal
  status          StatusVenda      @default(CONCLUIDA)
  tipoEntrega     TipoEntrega      @default(RETIRADA_BALCAO)
  statusEntrega   StatusEntrega?
  taxaEntrega     Decimal          @default(0.00)
  enderecoEntrega String?
  criadoEm        DateTime         @default(now())

  itens           ItemVenda[]
  pagamentos      PagamentoVenda[]
  fiados          HistoricoFiado[]
}

model ItemVenda {
  id            String   @id @default(uuid())
  vendaId       String
  venda         Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal
  precoTotal    Decimal
  criadoEm      DateTime @default(now())
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  FIADO
}

model PagamentoVenda {
  id             String         @id @default(uuid())
  vendaId        String
  venda          Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  formaPagamento FormaPagamento
  valor          Decimal
  troco          Decimal        @default(0.00)
  criadoEm       DateTime       @default(now())
}

// ====================================================
// 8. MOVIMENTAÇÃO DE ESTOQUE, AVARIAS E CASCOS
// ====================================================

enum TipoMovimentacaoEstoque {
  ENTRADA_COMPRA
  SAIDA_VENDA
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
  PERDA
  AVARIA
  AJUSTE_MANUAL
  AVARIA_PERDA
  ENTRADA_CASCO
  SAIDA_CASCO
}

model MovimentacaoEstoque {
  id         String                  @id @default(uuid())
  empresaId  Int
  empresa    Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produtoId  Int
  produto    Produto                 @relation(fields: [produtoId], references: [id])
  tipo       TipoMovimentacaoEstoque
  quantidade Int
  motivo     String?
  observacao String?
  criadoEm   DateTime                @default(now())
}

// ====================================================
// 9. FINANCEIRO COMPLETO (CONTAS A PAGAR / RECEBER)
// ====================================================

enum StatusConta {
  PENDENTE
  PAGO
  CANCELADO
}

model ContaPagar {
  id             String      @id @default(uuid())
  empresaId      Int
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  descricao      String
  categoria      String
  valor          Decimal
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusConta @default(PENDENTE)
  notaFiscalId   String?
  notaFiscal     NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  criadoEm       DateTime    @default(now())
}

model ContaReceber {
  id              String      @id @default(uuid())
  empresaId       Int
  empresa         Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  descricao       String
  valor           Decimal
  dataVencimento  DateTime
  dataRecebimento DateTime?
  status          StatusConta @default(PENDENTE)
  criadoEm        DateTime    @default(now())
}